{
  "description": "Force-cook a target node and return host errors/warnings in the same bounded recipe.",
  "id": "cook.checked",
  "optional": [],
  "promotion_state": "promoted",
  "required": [
    "path"
  ],
  "steps": [
    {
      "arguments": {
        "force": true,
        "path": {
          "$arg": "path"
        }
      },
      "op": "cook.execute",
      "save_as": "cook"
    },
    {
      "arguments": {
        "path": {
          "$arg": "path"
        }
      },
      "op": "host.errors",
      "save_as": "errors"
    }
  ],
  "supported_host_versions": [
    "21.0.440"
  ],
  "version": "1.0"
}
