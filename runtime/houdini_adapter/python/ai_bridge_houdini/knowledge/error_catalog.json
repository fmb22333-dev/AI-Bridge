{
  "rules": [
    {
      "id": "bridge.argument_invalid",
      "contains_all": [
        "ARGUMENT_INVALID:"
      ],
      "code": "ARGUMENT_INVALID",
      "category": "invalid_argument",
      "retryable": false,
      "suggestion": "Correct the operation argument shape using adapter.capabilities argument_schemas, then retry."
    },
    {
      "id": "vex.function_parameter_readwrite",
      "contains_all": [
        "read-only expression",
        "read/write parameter"
      ],
      "code": "VEX_FUNCTION_PARAMETER_READ_ONLY",
      "category": "vex_parameter_semantics",
      "retryable": false,
      "suggestion": "Copy the input parameter to a local variable before modifying it; use export only for intentional writable outputs."
    },
    {
      "id": "vex.macro_redefined",
      "contains_any": [
        "macro \"PI\" redefined",
        "PI redefined",
        "macro redefined"
      ],
      "code": "VEX_BUILTIN_MACRO_REDEFINED",
      "category": "vex_language_mismatch",
      "retryable": false,
      "suggestion": "Remove the redefinition of built-in/common macros or use a project-unique prefixed name."
    },
    {
      "id": "vex.unexpected_const",
      "contains_all": [
        "unexpected const"
      ],
      "code": "VEX_TOP_LEVEL_CONST_UNSUPPORTED",
      "category": "vex_language_mismatch",
      "retryable": false,
      "suggestion": "Use an ordinary typed variable unless this exact const context has been validated in the active Houdini VEX version."
    },
    {
      "id": "vex.undefined_function",
      "contains_any": [
        "call to undefined function",
        "undefined function"
      ],
      "code": "VEX_FUNCTION_NOT_AVAILABLE",
      "category": "vex_api_compatibility",
      "retryable": false,
      "suggestion": "Verify the function against the active Houdini VEX API and replace it with a validated equivalent."
    },
    {
      "id": "hom.invalid_input",
      "contains_any": [
        "invalid input",
        "Node_setInput"
      ],
      "code": "HOUDINI_INVALID_INPUT_CONNECTION",
      "category": "hom_connection",
      "retryable": false,
      "suggestion": "Inspect the actual target input count and source output index before reconnecting; do not infer connector indices."
    },
    {
      "id": "hom.attribute_name_none",
      "contains_all": [
        "attrib_name",
        "cannot be none"
      ],
      "code": "HOUDINI_ATTRIBUTE_NAME_REQUIRED",
      "category": "hom_attribute",
      "retryable": false,
      "suggestion": "Verify the attribute exists and pass its explicit name before reading point/prim attribute values."
    },
    {
      "id": "python.illegal_newline",
      "contains_all": [
        "illegal newline value"
      ],
      "code": "PYTHON_ILLEGAL_NEWLINE_ARGUMENT",
      "category": "python_io",
      "retryable": false,
      "suggestion": "Do not pass an invalid literal newline value; normally omit newline= and write UTF-8 text directly."
    },
    {
      "id": "hip.unknown_operator_load",
      "contains_any": [
        "unknown operator on load",
        "unknown operator"
      ],
      "code": "HOUDINI_HIP_UNKNOWN_OPERATOR",
      "category": "hip_serialization",
      "retryable": false,
      "suggestion": "Inspect the first unknown archive member/operator, CPIO member order, and serialized node definition before treating later load errors as independent."
    },
    {
      "id": "hip.cpio_directory_entry",
      "contains_all": [
        "missing file extension"
      ],
      "code": "HOUDINI_HIP_CPIO_DIRECTORY_ENTRY",
      "category": "hip_serialization",
      "retryable": false,
      "suggestion": "Do not emit directory entries such as obj/ into the HIP CPIO archive."
    },
    {
      "id": "hom.geometry_itervertices_unavailable",
      "contains_all": [
        "geometry",
        "itervertices"
      ],
      "code": "HOUDINI_HOM_API_UNAVAILABLE",
      "category": "hom_api_compatibility",
      "retryable": false,
      "suggestion": "Use a geometry iteration API verified on the active Houdini version; optional diagnostics must not crash the harness."
    },
    {
      "id": "geometry.degenerate_topology",
      "contains_all": [
        "degenerate topology"
      ],
      "code": "HOUDINI_DEGENERATE_TOPOLOGY",
      "category": "geometry_topology",
      "retryable": false,
      "suggestion": "Treat the warning as a topology diagnostic and verify whether downstream parameterization/flattening remains semantically valid before declaring PASS."
    },
    {
      "id": "vex.ambiguous.generic_return",
      "contains_any": [
        "ambiguous call",
        "ambiguous function"
      ],
      "code": "VEX_AMBIGUOUS_OVERLOAD_GENERIC_RETURN",
      "category": "vex_type_resolution",
      "retryable": false,
      "suggestion": "Store point()/prim()/detail() return values in explicitly typed temporaries before calling overloaded functions."
    },
    {
      "id": "vex.position_matrix_mix",
      "contains_all": [
        "matrix3",
        "vector"
      ],
      "contains_any": [
        "cannot convert",
        "invalid type",
        "ambiguous"
      ],
      "code": "VEX_POSITION_MATRIX_TYPE_MIX",
      "category": "vex_type_resolution",
      "retryable": false,
      "suggestion": "Keep position/vector values and matrix3 transforms explicitly separated; do not rely on implicit conversion."
    },
    {
      "id": "vex.cpp_style",
      "contains_any": [
        "PI redefined",
        "redefinition of 'PI'",
        "unexpected const",
        "unsupported function"
      ],
      "code": "VEX_CPP_STYLE_UNSUPPORTED",
      "category": "vex_language_mismatch",
      "retryable": false,
      "suggestion": "Treat the code as VEX rather than C++; remove C++-style top-level constants/macros/helpers that VEX does not support."
    },
    {
      "id": "vex.read_after_write",
      "contains_all": [
        "setpointattrib"
      ],
      "contains_any": [
        "uninitialized",
        "undefined",
        "unexpected value"
      ],
      "code": "VEX_ATTRIBUTE_READ_AFTER_WRITE_CAUTION",
      "category": "vex_dataflow",
      "retryable": false,
      "suggestion": "Do not assume an immediate point() read is authoritative for a value just written with setpointattrib in the same algorithmic step."
    }
  ]
}
