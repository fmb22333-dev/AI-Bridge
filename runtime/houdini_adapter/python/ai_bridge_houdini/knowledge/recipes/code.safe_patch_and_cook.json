{
  "id": "code.safe_patch_and_cook",
  "version": "1.0",
  "description": "Transactional code patch: optimistic read/patch, Cook, collect host errors on Cook failure, with Core checkpoint rollback on failed recipe.apply.",
  "required": [
    "path",
    "parameter",
    "old_text",
    "new_text",
    "cook_path"
  ],
  "optional": [],
  "steps": [
    {
      "op": "code.read",
      "save_as": "read",
      "arguments": {
        "path": {
          "$arg": "path"
        },
        "parameter": {
          "$arg": "parameter"
        }
      }
    },
    {
      "op": "code.patch",
      "save_as": "patch",
      "arguments": {
        "path": {
          "$arg": "path"
        },
        "parameter": {
          "$arg": "parameter"
        },
        "old_text": {
          "$arg": "old_text"
        },
        "new_text": {
          "$arg": "new_text"
        },
        "expected_hash": {
          "$result": "read.hash"
        }
      }
    },
    {
      "op": "cook.execute",
      "save_as": "cook",
      "arguments": {
        "path": {
          "$arg": "cook_path"
        },
        "force": true
      },
      "stop_on_failure": false
    },
    {
      "op": "host.errors",
      "save_as": "errors",
      "when": {
        "$result_equals": {
          "path": "cook.cook_status",
          "value": "FAILED"
        }
      },
      "arguments": {
        "path": {
          "$arg": "cook_path"
        }
      }
    }
  ]
}
