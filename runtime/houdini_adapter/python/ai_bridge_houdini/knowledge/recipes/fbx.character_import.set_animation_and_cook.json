{
  "id": "fbx.character_import.set_animation_and_cook",
  "version": "1.0",
  "description": "Safely set a KineFX FBX Character Import Animation FBX File, force-cook the same node, and return host diagnostics.",
  "required": [
    "path",
    "animation_file"
  ],
  "optional": [],
  "supported_host_versions": [
    "21.0.440"
  ],
  "supported_node_types": [
    "kinefx::Sop/fbxcharacterimport"
  ],
  "promotion_state": "promoted",
  "provenance": [
    "historical_retarget_batch_workflow",
    "live_houdini_21_0_440_validation",
    "p1_phase3"
  ],
  "steps": [
    {
      "op": "parm.read",
      "save_as": "read",
      "arguments": {
        "path": {
          "$arg": "path"
        },
        "parameter": "animfbxfile"
      }
    },
    {
      "op": "parm.write",
      "save_as": "write",
      "arguments": {
        "path": {
          "$arg": "path"
        },
        "parameter": "animfbxfile",
        "value": {
          "$arg": "animation_file"
        },
        "expected_hash": {
          "$result": "read.hash"
        }
      }
    },
    {
      "op": "cook.execute",
      "save_as": "cook",
      "arguments": {
        "path": {
          "$arg": "path"
        },
        "force": true
      }
    },
    {
      "op": "host.errors",
      "save_as": "errors",
      "arguments": {
        "path": {
          "$arg": "path"
        }
      }
    }
  ]
}
