      "state": "candidate",
      "scope": "animation_project_family",
      "host": "houdini",
      "description": "Project the root displacement onto a chosen 8-direction horizontal axis while leaving non-root joints unchanged.",
      "algorithm": "fixedP = startP + dir8 * dot(originalP - startP, dir8)",
